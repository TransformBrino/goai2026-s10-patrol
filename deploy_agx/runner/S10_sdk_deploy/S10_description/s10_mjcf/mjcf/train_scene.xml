<!--
  微调训练场景：机器人 + 可在运行时改写的高程场。

  用 hfield 而不是 box 几何，是因为 MuJoCo 的 hfield_data 可以每回合直接改写，
  不需要重建模型 —— 一个进程就能跑遍平地/坡/上台阶/下陡坎/碎石各种地形。

  分辨率 5 cm（480×480 覆盖 24×24 m）：赛道实测主力踏步 12.5 cm、
  主阻塞是一道 38 cm 陡坎，5 cm 格子能把这种锐利边缘表达到 ~82° 坡，够用。

  注意：必须和 S10.xml 放同一目录，include 与 meshdir 都是相对路径。
-->
<mujoco model="S10_train">
  <include file="./S10.xml"/>

  <asset>
    <hfield name="terrain" nrow="480" ncol="480" size="12 12 1.0 0.1"/>
  </asset>

  <worldbody>
    <geom name="terrain" type="hfield" hfield="terrain" pos="0 0 0"
          rgba="0.52 0.55 0.52 1" friction="1 0.01 0.001" condim="3"
          contype="1" conaffinity="1"/>
  </worldbody>
</mujoco>
